[Unit]
Description=DevOps Web Application
After=network.target

[Service]
Type=simple
User=isuzmen
WorkingDirectory=/home/isuzmen/devops-web/app
ExecStart=/usr/bin/python3 -m http.server 3000 --bind 127.0.0.1 --directory /home/isuzmen/devops-web/app
Restart=on-failure

[Install]
WantedBy=multi-user.target
